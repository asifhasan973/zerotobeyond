      "url": "/story/audio/male/glossary/male-word-spaceweather.mp3",
      "voice": "en-US-AndrewNeural",
      "sha256": "e7909e6da83a439e642ce93230eac662934de584a7c625933207658c6d6f0e0e"
    },
