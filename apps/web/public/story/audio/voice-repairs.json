      "url": "/story/audio/male/glossary/male-word-rocketequation.mp3",
      "voice": "en-US-AndrewNeural",
      "sha256": "103a46847b629acea74b52859f219d5d06bf55e4a0ed283e4c8d589e741d9c7b"
    },
